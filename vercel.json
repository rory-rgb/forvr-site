{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/about",
      "destination": "/studio",
      "permanent": true
    },
    {
      "source": "/process",
      "destination": "/services",
      "permanent": true
    },
    {
      "source": "/system",
      "destination": "/studio",
      "permanent": true
    },
    {
      "source": "/motion-lab",
      "destination": "/work",
      "permanent": true
    },
    {
      "source": "/rorywilkieportfolio",
      "destination": "/rorywilkie",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/meta/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/demo/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/rory-wilkie-portfolio.pdf",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
